import os, shutil, time, subprocess

BASE = os.path.dirname(os.path.abspath(__file__))

def find_file(*names):
    for n in names:
        p = os.path.join(BASE, n)
        if os.path.isfile(p):
            return p
    return None

def read(p):
    with open(p, encoding='utf-8') as f:
        return f.read()

def write(p, s):
    with open(p, 'w', encoding='utf-8') as f:
        f.write(s)

def backup(p):
    b = f"{p}.backup_{time.strftime('%Y%m%d_%H%M%S')}"
    shutil.copy2(p, b)
    return b

def report(name, done, already=False):
    if done:
        print(f"  [FIXED]   {name}")
    elif already:
        print(f"  [OK]      {name} (pehle se theek hai)")
    else:
        print(f"  [SKIP]    {name} (code nahi mila - manually check karein)")

