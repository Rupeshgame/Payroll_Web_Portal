def fix_app(path):
    src = read(path)
    orig = src
    print(f"\napp.py: {path}")

    # 1. "no such column: s_no" fix
    if 'sm2_backup_table' in src:
        report('Salary Master 2 table (s_no error)', False, True)
    else:
        start = src.find('    # 6. Salary Master 2 roster')
        end = src.find('    # Default Config', start)
        if start != -1 and end != -1:
            src = src[:start] + NEW_SM2_BLOCK + src[end:]
            report('Salary Master 2 table (s_no error)', True)
        else:
            report('Salary Master 2 table (s_no error)', False)

    # 2. Delete karne par doosre employees ka data delete hone wala bug
    old = '(f"%{emp_id}%",)'
    if old in src:
        src = src.replace(old, '(f"%-{emp_id}",)')
        report('Employee delete LIKE query', True)
    else:
        report('Employee delete LIKE query', False, '(f"%-{emp_id}",)' in src)

    # 3. Cleanup auto-created employees (STAFF vs Staff)
    old = "WHERE designation = 'Staff'"
    new = "WHERE UPPER(COALESCE(designation, '')) = 'STAFF'"
    if old in src:
        src = src.replace(old, new)
        report('Cleanup STAFF designation', True)
    else:
        report('Cleanup STAFF designation', False, new in src)

    # 4. Khaali name se frontend crash
    old = "'name': r['name'],"
    if old in src:
        src = src.replace(old, "'name': r['name'] or '',", 1)
        report('Empty employee name', True)
    else:
        report('Empty employee name', False, "'name': r['name'] or ''," in src)

    # 5. Bulk import crash
    old = "employees_list = request.json.get('employees', [])"
    new = "employees_list = (request.get_json(silent=True) or {}).get('employees', [])"
    if old in src:
        src = src.replace(old, new)
        report('Bulk import request', True)
    else:
        report('Bulk import request', False, new in src)

    # 6. Stray semicolon
    src = src.replace("ws['G1'].number_format = ';;;';", "ws['G1'].number_format = ';;;'")

    if src != orig:
        try:
            compile(src, 'app.py', 'exec')
        except SyntaxError as e:
            print(f"  !! Syntax error aaya, app.py SAVE NAHI ki gayi: {e}")
            return
        print(f"  Backup: {backup(path)}")
        write(path, src)
        print("  app.py save ho gayi.")
    else:
        print("  Koi badlav ki zaroorat nahi.")

