def fix_js(path):
    js = read(path)
    orig = js
    print(f"\nscript.js: {path}")

    # 1. isMgr is not defined (Dashboard)
    i = js.find('function updateDashboardAnalytics()')
    if i != -1:
        j = js.find('employees.forEach(emp => {', i)
        k = js.find('calculateEmpPayroll', j)
        if j != -1 and k != -1:
            if 'const isMgr' in js[j:k]:
                report('Dashboard isMgr error', False, True)
            else:
                pos = j + len('employees.forEach(emp => {')
                js = js[:pos] + '\n        const isMgr = isManagerEmployee(emp);' + js[pos:]
                report('Dashboard isMgr error', True)
        else:
            report('Dashboard isMgr error', False)
    else:
        report('Dashboard isMgr error', False)

    # 2. Salary Master columns khisakna
    old_th = '<th class="p-3 text-center border-b border-slate-800 bg-slate-900 w-14 sticky left-0 z-30">S.N.</th>'
    new_th = ('<th class="p-3 text-center border-b border-slate-800 bg-slate-900 w-10">'
              '<input type="checkbox" id="master-select-all-cb" onchange="toggleSelectAllEmployees(this.checked)" '
              'class="rounded text-sky-600 cursor-pointer"></th>\n                '
              '<th class="p-3 text-center border-b border-slate-800 bg-slate-900 w-12">S.N.</th>')
    if old_th in js:
        js = js.replace(old_th, new_th, 1)
        old_cs = '<td colspan="3" class="p-3 text-right uppercase tracking-wider sticky left-0 bg-slate-200 z-10">'
        js = js.replace(old_cs, old_cs.replace('colspan="3"', 'colspan="4"'), 1)
        report('Salary Master table columns', True)
    else:
        report('Salary Master table columns', False, 'bg-slate-900 w-12">S.N.</th>' in js)

    # 3. Status colour (ACTIVE / LEFT)
    old = "const statusColor = val === 'Active' ? 'bg-emerald-100 text-emerald-800' : (val === 'Left' ? 'bg-rose-100 text-rose-800' : 'bg-slate-200 text-slate-700');"
    new = ("const stUp = String(val || 'ACTIVE').toUpperCase();\n"
           "                    const statusColor = stUp === 'ACTIVE' ? 'bg-emerald-100 text-emerald-800' : "
           "(stUp === 'LEFT' ? 'bg-rose-100 text-rose-800' : 'bg-slate-200 text-slate-700');")
    if old in js:
        js = js.replace(old, new)
        report('Status colour', True)
    else:
        report('Status colour', False, 'const stUp' in js)

    # 4. Search crash (khaali name/code)
    n = js.count('emp.name.toLowerCase()') + js.count('emp.code.toLowerCase()')
    js = js.replace('emp.name.toLowerCase()', "String(emp.name || '').toLowerCase()")
    js = js.replace('emp.code.toLowerCase()', "String(emp.code || '').toLowerCase()")
    report(f'Search crash ({n} jagah)', n > 0, n == 0)

    # 5. Salary matrix mein har mahina 31 din
    old = 'calculateEmpPayroll(emp, 31, (rec ? rec.paidDays : 31), rec)'
    new = ('calculateEmpPayroll(emp, new Date(m.year, m.monthNum, 0).getDate(), '
           '(rec ? rec.paidDays : new Date(m.year, m.monthNum, 0).getDate()), rec)')
    c = js.count(old)
    js = js.replace(old, new)
    report(f'Matrix days-in-month ({c} jagah)', c > 0, c == 0)

    if js != orig:
        print(f"  Backup: {backup(path)}")
        write(path, js)
        print("  script.js save ho gayi.")
        try:
            r = subprocess.run(['node', '--check', path], capture_output=True, text=True)
            print("  JS syntax check: OK" if r.returncode == 0 else f"  !! JS syntax error:\n{r.stderr}")
        except FileNotFoundError:
            pass  # Node installed nahi hai, check skip
    else:
        print("  Koi badlav ki zaroorat nahi.")

